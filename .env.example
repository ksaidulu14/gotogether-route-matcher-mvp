# GoTogetherRides Open Map Infrastructure Configuration

# Map Visualization (MapLibre GL JS + PMTiles)
MAP_PROVIDER=maplibre
PMTILES_URL=/map/hyderabad.pmtiles

# Routing Service (OSRM Abstraction)
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding Service (Nominatim / Custom Abstraction)
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=GoTogetherRides-OpenMap/1.0
